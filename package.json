{
  "name": "comftripbackend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:postman": "npx newman run ./tests/postman/postman_collection.json -e ./tests/postman/postman_env.json -r cli,html --reporter-html-export ./reports/postman-report.html",
    "test:postman:junit": "npx newman run ./tests/postman/postman_collection.json -e ./tests/postman/postman_env.json -r cli,junit --reporter-junit-export ./reports/junit-report.xml"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.3.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "newman": "^4.6.1",
    "newman-reporter-html": "^1.0.5",
    "nodemon": "^2.0.22"
  }
}
